{
  "uid": "quant-live",
  "title": "vLLM quantization variants live",
  "description": "vLLM /metrics from the BF16, FP8 and AWQ servers every 5 s, split by the variant label set in the Prometheus config.",
  "tags": [
    "vllm",
    "quantization",
    "prometheus"
  ],
  "schemaVersion": 41,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Running requests",
      "description": "Requests in the running batch. Flat at the engine limit (256 on L40S) means the batch is full.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false,
            "fillOpacity": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "bf16"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "fp8"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "awq"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#2a9d5c"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (variant) (vllm:num_requests_running)",
          "legendFormat": "{{variant}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Queued requests",
      "description": "Requests waiting for admission to the batch. Sustained growth means the engine is saturated.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
